{% comment %} Settings and date helpers {% endcomment %}
{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign days = settings.days | split: ',' %}
{% assign months = settings.months | split: ',' %}
{% assign tomorrow_label = settings.tomorrow %}
{% assign events_label = settings.events_label %}

{% assign today_iso = 'now' | date: '%Y-%m-%d' %}
{% assign today_ts = today_iso | date: '%s' %}
{% assign tomorrow_iso = today_ts | plus: 86400 | date: '%Y-%m-%d' %}
{% assign current_year = today_iso | date: '%Y' %}

{% assign month_index = today_iso | date: '%m' | minus: 1 %}
{% assign day_index = today_iso | date: '%w' | plus: 6 | modulo: 7 %}
{% assign today_date = today_iso | date: '%d' | append: ' ' | append: months[month_index] %}
{% assign today_day = days[day_index] %}

{% comment %} Closest important event countdown {% endcomment %}
{% assign important_events = settings.important_events | split: ',' %}
{% assign countdown_days_remaining = 9999 %}

{% for item in important_events %}
  {% if item != blank %}
    {% assign parts = item | split: ';' %}
    {% assign full_date = current_year | append: '-' | append: parts[0] %}
    {% if full_date < today_iso %}
      {% assign full_date = current_year | plus: 1 | append: '-' | append: parts[0] %}
    {% endif %}

    {% assign days_left = full_date | date: '%s' | minus: today_ts | divided_by: 86400 %}
    {% if days_left < countdown_days_remaining %}
      {% assign countdown_days_remaining = days_left %}
      {% assign countdown_title = parts[1] %}
    {% endif %}
  {% endif %}
{% endfor %}

{% comment %} Reusable templates {% endcomment %}
{% template upcoming_date %}
  <span class="label label--inverted p--1 pb--0.5">
    {% if target_date == tomorrow_iso %}
      {{ tomorrow_label }}
    {% else %}
      {% assign day_idx = target_date | date: '%w' | plus: 6 | modulo: 7 %}
      {% assign month_idx = target_date | date: '%m' | minus: 1 %}
      {{ days[day_idx] }}, {{ target_date | date: '%d' }} {{ months[month_idx] }}
    {% endif %}
  </span>
{% endtemplate %}

{% template weather_by_date %}
  {% for date in weather.daily.time %}
    {% if date == target_date %}
      <span class="label p--1 flex flex--center gap--small">
        <img class="w--5" src="https://zoltan.co/rpi-dash/images/weather/{{ weather.daily.weather_code[forloop.index0] }}.svg">
        {{ weather.daily.temperature_2m_max[forloop.index0] }}&deg;
      </span>
      {% break %}
    {% endif %}
  {% endfor %}
{% endtemplate %}
